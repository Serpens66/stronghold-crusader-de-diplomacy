          <Style x:Key="DiplomacyActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BTN_SH_Plain}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Grid>
                    <Rectangle Fill="Transparent"/>
                    <Image Name="SpriteInactive" IsHitTestVisible="False" Stretch="Fill" Source="{TemplateBinding local:PropEx.Sprite1}"/>
                    <Image Name="SpriteMouseOver" IsHitTestVisible="False" Stretch="Fill" Source="{TemplateBinding local:PropEx.Sprite2}" Visibility="Hidden"/>
                    <Image Name="SpriteMousePressed" IsHitTestVisible="False" Stretch="Fill" Source="{TemplateBinding local:PropEx.Sprite3}" Visibility="Hidden"/>
                    <Image Name="SpriteLocked" IsHitTestVisible="False" Stretch="Fill" Source="{TemplateBinding local:PropEx.Sprite4}" Visibility="Hidden"/>
                    <Border Name="KeyFocus" IsHitTestVisible="False" BorderBrush="#FFD9B56D" BorderThickness="1" Margin="2" Visibility="Hidden"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="SpriteLocked" Property="Visibility" Value="Hidden"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="SpriteInactive" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteMouseOver" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteMousePressed" Property="Visibility" Value="Hidden"/>
                      <Setter TargetName="SpriteLocked" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="KeyFocus" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="DiplomacyAllianceRow" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource BTN_RADIO_Image}">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                  <Border Name="RowBackground" Background="#88000000" BorderBrush="#00000000" BorderThickness="1"/>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="RowBackground" Property="Background" Value="#FFB52E0C"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="RowBackground" Property="Background" Value="#FFA11F08"/>
                      <Setter TargetName="RowBackground" Property="BorderBrush" Value="#FFD9B56D"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="RowBackground" Property="Background" Value="#FFC2240C"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="RowBackground" Property="Opacity" Value="0.48"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="RowBackground" Property="BorderBrush" Value="#FFFFD700"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
